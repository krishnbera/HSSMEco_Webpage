{
  "ci": {
    "collect": {
      "startServerCommand": "npx astro preview --host 127.0.0.1 --port 4321",
      "startServerReadyPattern": "127.0.0.1:4321",
      "url": [
        "http://127.0.0.1:4321/HSSMEco_Webpage/",
        "http://127.0.0.1:4321/HSSMEco_Webpage/ecosystem/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "first-contentful-paint": ["error", { "maxNumericValue": 1500 }],
        "total-byte-weight": ["error", { "maxNumericValue": 1048576 }],
        "unused-javascript": ["warn", { "maxNumericValue": 10240 }],
        "uses-responsive-images": "off"
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
